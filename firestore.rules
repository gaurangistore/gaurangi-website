rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Anyone can read content and images
    match /content/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /images/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Newsletter signups were removed in Phase 2. Any existing documents are
    // left in place so nothing is destroyed, but they are no longer written to
    // and are not reachable from the site. Delete the collection manually in the
    // Firebase console once you are happy the old list is not needed.
    
    // User role documents
    match /users/{userId} {
      // Users can read their own profile, admins can read all
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Users can create their own profile upon signup
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Only admins can update or delete profiles (prevents users from upgrading themselves to admin)
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
